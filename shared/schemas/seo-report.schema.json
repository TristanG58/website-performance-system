{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TristanG58/website-performance-system/shared/schemas/seo-report.schema.json",
  "title": "SEO/GEO-Monitor-Report",
  "description": "Strukturierter Report des kontinuierlichen SEO/GEO-Monitors (evaluate.py). Stabiler Vertrag für die spätere Dashboard-Anbindung. Enthält KEINE Kundendaten ausser clientId/liveUrl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportVersion", "liveUrl", "generatedAt", "standardVersion", "summary", "findings"],
  "properties": {
    "reportVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "clientId": { "type": ["string", "null"] },
    "trade": { "type": ["string", "null"] },
    "liveUrl": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "standardVersion": { "type": "string", "description": "standardVersion, gegen die geprüft wurde." },
    "baselineStandardVersion": { "type": ["string", "null"], "description": "standardVersion der Baseline; weicht sie ab, gibt es ein Upgrade-Finding." },
    "driftStatus": {
      "type": "string",
      "description": "Ergebnis der Live-vs-Baseline-Drift-Prüfung. 'disabled' = nicht ausgeführt, 'baseline_established' = erste Baseline erfasst (noch kein Vergleich), 'compared' = verglichen, 'no_baseline' = keine Baseline und nicht erfasst, 'error: ...' = Fehler.",
      "pattern": "^(disabled|compared|baseline_established|no_baseline|error:.*)$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "warning", "info", "total"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "notEvaluated": {
      "type": "array",
      "description": "IDs von require-Regeln, die diese Ausbaustufe noch nicht prüft (z. B. robots/sitemap/nap).",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "severity", "title", "detail"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["gap", "regression", "deprecated", "upgrade"],
          "description": "gap=Nichteinhaltung · regression=Änderung ggü. Baseline · deprecated=überholtes Feature · upgrade=Standard weiterentwickelt."
        },
        "severity": { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO"] },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "expected": { "description": "Soll-Wert (beliebiger Typ)." },
        "actual": { "description": "Ist-Wert (beliebiger Typ)." },
        "rationale": { "type": ["string", "null"] }
      }
    }
  }
}
