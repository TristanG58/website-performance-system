# ── website-performance-system · .gitignore ─────────────────────────────
# Zentrales Repo: Templates, Shared Modules, Plugins/Skills/Agents,
# Automation, Migrationen, Tests, Registry, Docs.
# KEINE Kundenprojekte, keine Roh-Assets, keine Build-Artefakte, keine Secrets.

# ── Dependencies ────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ── Build- / Framework-Output ──────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
.vite/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo

# ── Roh-Assets (bleiben pro Kunde, nie zentral einchecken) ─────────────
assets/raw/
**/assets/raw/

# ── Secrets & Environment ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.vercel
.netlify

# ── Python (Bild-Pipeline: Pillow/sharp-Skripte) ───────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ── Test- / Coverage-Output ────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
.playwright-mcp/

# ── Logs ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / IDE ───────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
